#!/bin/sh
set -eu

SERVICE_NAME='dnscrypt-proxy.service'
HELPER_PATH='/usr/local/libexec/cryptshield-helper'

event="${2:-}"

case "$event" in
    up|vpn-up|dhcp4-change|dhcp6-change|connectivity-change)
        ;;
    *)
        exit 0
        ;;
esac

[ -x "$HELPER_PATH" ] || exit 0
command -v systemctl >/dev/null 2>&1 || exit 0
systemctl is-active --quiet "$SERVICE_NAME" || exit 0

"$HELPER_PATH" route
