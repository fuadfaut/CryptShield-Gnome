#!/bin/sh
set -eu

SERVICE_NAME='dnscrypt-proxy.service'
CONFIG_PATH='/etc/dnscrypt-proxy/dnscrypt-proxy.toml'
LOCAL_DNS_IPV4='127.0.0.1'
LOCAL_DNS_IPV6='::1'
LOCAL_DNS_PRIORITY='-50'
DNS_PROBE_HOST='example.com'
DNS_READY_TIMEOUT_SECONDS='90'
STATE_DIR='/var/lib/cryptshield'

usage() {
    echo "Usage: cryptshield-helper activate|restart|configure RESOLVER CACHE DNSSEC FORCE_TCP" >&2
    echo "       cryptshield-helper route" >&2
    echo "       cryptshield-helper deactivate" >&2
    echo "       cryptshield-helper startup true|false" >&2
    exit 2
}

is_managed_dns_connection() {
    case "$1" in
        loopback|dummy) return 1 ;;
        *) return 0 ;;
    esac
}

validate_bool() {
    case "$1" in
        true|false) return 0 ;;
        *) usage ;;
    esac
}

validate_resolver() {
    case "$1" in
        ''|cloudflare|quad9|quad9-dnscrypt-ip4-filter-pri|adguard|adguard-dns|adguard-dns-doh|google|nextdns|cisco|mullvad-doh|cleanbrowsing-adult|doh.tiar.app|doh.tiar.app-doh) return 0 ;;
        *) usage ;;
    esac
}

prepare_runtime_dirs() {
    mkdir -p /var/cache/dnscrypt-proxy
    mkdir -p "$STATE_DIR"
}

backup_nm_dns_profiles() {
    command -v nmcli >/dev/null 2>&1 || return 0
    mkdir -p "$STATE_DIR"

    nmcli -t -f UUID,TYPE connection show --active | while IFS=: read -r uuid type; do
        [ -n "$uuid" ] || continue
        is_managed_dns_connection "$type" || continue

        backup_file="$STATE_DIR/nm-$uuid"
        [ -f "$backup_file" ] && continue

        nmcli -g ipv4.dns,ipv4.ignore-auto-dns,ipv4.dns-priority,ipv6.dns,ipv6.ignore-auto-dns,ipv6.dns-priority connection show "$uuid" > "$backup_file"
    done
}

restore_nm_dns_profiles() {
    command -v nmcli >/dev/null 2>&1 || return 0

    restored=false
    for backup_file in "$STATE_DIR"/nm-*; do
        [ -f "$backup_file" ] || continue
        restored=true
        uuid="${backup_file##*/nm-}"
        ipv4_dns="$(sed -n '1p' "$backup_file")"
        ipv4_ignore="$(sed -n '2p' "$backup_file")"
        ipv4_priority="$(sed -n '3p' "$backup_file")"
        ipv6_dns="$(sed -n '4p' "$backup_file")"
        ipv6_ignore="$(sed -n '5p' "$backup_file")"
        ipv6_priority="$(sed -n '6p' "$backup_file")"

        nmcli connection modify "$uuid" \
            ipv4.dns "$ipv4_dns" \
            ipv4.ignore-auto-dns "${ipv4_ignore:-no}" \
            ipv4.dns-priority "${ipv4_priority:-0}" \
            ipv6.dns "$ipv6_dns" \
            ipv6.ignore-auto-dns "${ipv6_ignore:-no}" \
            ipv6.dns-priority "${ipv6_priority:-0}" || continue
    done

    if [ "$restored" = false ]; then
        nmcli -t -f UUID,TYPE connection show --active | while IFS=: read -r uuid type; do
            [ -n "$uuid" ] || continue
            is_managed_dns_connection "$type" || continue
            nmcli connection modify "$uuid" \
                ipv4.dns "" \
                ipv4.ignore-auto-dns no \
                ipv4.dns-priority 0 \
                ipv6.dns "" \
                ipv6.ignore-auto-dns no \
                ipv6.dns-priority 0 || true
        done
    fi

    nmcli -t -f UUID,DEVICE connection show --active | while IFS=: read -r uuid device; do
        [ -n "$uuid" ] || continue
        [ -n "$device" ] || continue
        nmcli device reapply "$device" >/dev/null 2>&1 || nmcli connection up "$uuid" >/dev/null 2>&1 || true
    done
}

restore_runtime_dns_from_nm() {
    command -v nmcli >/dev/null 2>&1 || return 0
    command -v resolvectl >/dev/null 2>&1 || return 0

    nmcli -t -f DEVICE,STATE device status | while IFS=: read -r device state; do
        [ -n "$device" ] || continue
        [ "$device" != "lo" ] || continue
        [ "$state" = "connected" ] || continue

        dns_servers="$(nmcli -g IP4.DNS,IP6.DNS device show "$device" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
        [ -n "$dns_servers" ] || continue

        # shellcheck disable=SC2086
        resolvectl dns "$device" $dns_servers || true
        resolvectl default-route "$device" yes || true
    done
}

clear_saved_state() {
    rm -f "$STATE_DIR"/nm-* 2>/dev/null || true
}

probe_local_dns_once() {
    if command -v dig >/dev/null 2>&1; then
        dig @"$LOCAL_DNS_IPV4" "$DNS_PROBE_HOST" A +time=1 +tries=1 +short 2>/dev/null | grep -q .
        return $?
    fi

    if command -v nslookup >/dev/null 2>&1; then
        nslookup -timeout=1 "$DNS_PROBE_HOST" "$LOCAL_DNS_IPV4" >/dev/null 2>&1
        return $?
    fi

    command -v dnscrypt-proxy >/dev/null 2>&1 || return 1
    dnscrypt-proxy -resolve "$DNS_PROBE_HOST,$LOCAL_DNS_IPV4:53" >/dev/null 2>&1
}

wait_for_local_dns() {
    deadline=$(( $(date +%s) + DNS_READY_TIMEOUT_SECONDS ))

    while [ "$(date +%s)" -le "$deadline" ]; do
        if probe_local_dns_once; then
            return 0
        fi

        sleep 1
    done

    echo "CryptShield: local DNS did not become ready; system DNS was not routed." >&2
    return 1
}

has_local_ipv4() {
    case " $1 " in
        *" $LOCAL_DNS_IPV4 "*|*" $LOCAL_DNS_IPV4,"*|*",$LOCAL_DNS_IPV4 "*|*",$LOCAL_DNS_IPV4,"*) return 0 ;;
        *) return 1 ;;
    esac
}

has_local_ipv6() {
    case " $1 " in
        *" $LOCAL_DNS_IPV6 "*|*" [$LOCAL_DNS_IPV6] "*|*" $LOCAL_DNS_IPV6,"*|*" [$LOCAL_DNS_IPV6],"*|*",$LOCAL_DNS_IPV6 "*|*",[$LOCAL_DNS_IPV6] "*) return 0 ;;
        *) return 1 ;;
    esac
}

connection_uses_local_dns() {
    uuid="$1"
    profile="$(nmcli -g ipv4.dns,ipv4.ignore-auto-dns,ipv6.dns,ipv6.ignore-auto-dns connection show "$uuid" 2>/dev/null || true)"
    [ -n "$profile" ] || return 1

    ipv4_dns="$(printf '%s\n' "$profile" | sed -n '1p' | sed 's/\\:/:/g')"
    ipv4_ignore="$(printf '%s\n' "$profile" | sed -n '2p')"
    ipv6_dns="$(printf '%s\n' "$profile" | sed -n '3p' | sed 's/\\:/:/g')"
    ipv6_ignore="$(printf '%s\n' "$profile" | sed -n '4p')"

    has_local_ipv4 "$ipv4_dns" || return 1
    [ "$ipv4_ignore" = yes ] || return 1

    if [ -n "$ipv6_dns" ]; then
        has_local_ipv6 "$ipv6_dns" || return 1
        [ "$ipv6_ignore" = yes ] || return 1
    fi

    return 0
}

bool_expression() {
    key="$1"
    value="$2"
    printf '0,/^[ ]*#?[ ]*%s[ ]*=.*/s//%s = %s/' "$key" "$key" "$value"
}

resolver_expression() {
    resolver="$1"

    if [ -z "$resolver" ]; then
        printf "0,/^[ ]*#?[ ]*server_names[ ]*=.*/s//# server_names = ['cloudflare']/"
    else
        printf "0,/^[ ]*#?[ ]*server_names[ ]*=.*/s//server_names = ['%s']/" "$resolver"
    fi
}

configure_dnscrypt() {
    resolver="${1:-}"
    caching="${2:-}"
    dnssec="${3:-}"
    force_tcp="${4:-}"

    validate_resolver "$resolver"
    validate_bool "$caching"
    validate_bool "$dnssec"
    validate_bool "$force_tcp"

    sed -i -E \
        -e "$(resolver_expression "$resolver")" \
        -e "0,/^[ ]*#?[ ]*listen_addresses[ ]*=.*/s//listen_addresses = ['$LOCAL_DNS_IPV4:53', '[$LOCAL_DNS_IPV6]:53']/" \
        -e "$(bool_expression cache "$caching")" \
        -e "$(bool_expression require_dnssec "$dnssec")" \
        -e "$(bool_expression force_tcp "$force_tcp")" \
        -e "0,/^[ ]*#?[ ]*file[ ]*=[ ]*'query.log'/s//file = '\\/var\\/log\\/dnscrypt-query.log'/" \
        -e "/^\\[blocked_names\\]/,/^\\[blocked_ips\\]/s|^[ ]*#?[ ]*blocked_names_file[ ]*=.*|blocked_names_file = '/etc/dnscrypt-proxy/blocked-names.txt'|" \
        -e "/^\\[blocked_names\\]/,/^\\[blocked_ips\\]/s|^[ ]*#?[ ]*log_file[ ]*=.*|log_file = '/var/log/dnscrypt-blocked-names.log'|" \
        -e "/^\\[blocked_ips\\]/,/^\\[allowed_names\\]/s|^[ ]*#?[ ]*blocked_ips_file[ ]*=.*|blocked_ips_file = '/etc/dnscrypt-proxy/blocked-ips.txt'|" \
        -e "/^\\[blocked_ips\\]/,/^\\[allowed_names\\]/s|^[ ]*#?[ ]*log_file[ ]*=.*|log_file = '/var/log/dnscrypt-blocked-ips.log'|" \
        "$CONFIG_PATH"
}

route_system_dns() {
    wait_for_local_dns

    if command -v nmcli >/dev/null 2>&1; then
        backup_nm_dns_profiles

        nmcli -t -f UUID,TYPE,DEVICE connection show --active | while IFS=: read -r uuid type device; do
            [ -n "$uuid" ] || continue
            is_managed_dns_connection "$type" || continue

            if connection_uses_local_dns "$uuid"; then
                if [ -n "$device" ] && command -v resolvectl >/dev/null 2>&1; then
                    resolvectl dns "$device" "$LOCAL_DNS_IPV4" "$LOCAL_DNS_IPV6" || true
                    resolvectl domain "$device" '~.' || true
                    resolvectl default-route "$device" yes || true
                fi
                continue
            fi

            nmcli connection modify "$uuid" \
                ipv4.dns "$LOCAL_DNS_IPV4" \
                ipv4.ignore-auto-dns yes \
                ipv4.dns-priority "$LOCAL_DNS_PRIORITY" \
                ipv6.dns "$LOCAL_DNS_IPV6" \
                ipv6.ignore-auto-dns yes \
                ipv6.dns-priority "$LOCAL_DNS_PRIORITY" || continue

            if [ -n "$device" ]; then
                nmcli device reapply "$device" >/dev/null 2>&1 || nmcli connection up "$uuid" >/dev/null 2>&1 || true
            fi
        done
    fi

    if command -v resolvectl >/dev/null 2>&1 && command -v nmcli >/dev/null 2>&1; then
        nmcli -t -f DEVICE,STATE device status | while IFS=: read -r device state; do
            [ -n "$device" ] || continue
            [ "$device" != "lo" ] || continue
            [ "$state" = "connected" ] || continue
            resolvectl dns "$device" "$LOCAL_DNS_IPV4" "$LOCAL_DNS_IPV6" || true
            resolvectl domain "$device" '~.' || true
            resolvectl default-route "$device" yes || true
        done
    fi
}

revert_system_dns() {
    restore_nm_dns_profiles
    restore_runtime_dns_from_nm
    clear_saved_state
}

action="${1:-}"

if [ "$#" -gt 0 ]; then
    shift
fi

case "$action" in
    activate)
        [ "$#" -eq 4 ] || usage
        prepare_runtime_dirs
        configure_dnscrypt "$1" "$2" "$3" "$4"
        systemctl start "$SERVICE_NAME"
        route_system_dns || {
            systemctl stop "$SERVICE_NAME" || true
            revert_system_dns
            exit 1
        }
        ;;
    restart)
        [ "$#" -eq 4 ] || usage
        prepare_runtime_dirs
        configure_dnscrypt "$1" "$2" "$3" "$4"
        systemctl restart "$SERVICE_NAME"
        route_system_dns || {
            systemctl stop "$SERVICE_NAME" || true
            revert_system_dns
            exit 1
        }
        ;;
    configure)
        [ "$#" -eq 4 ] || usage
        prepare_runtime_dirs
        configure_dnscrypt "$1" "$2" "$3" "$4"
        ;;
    route)
        [ "$#" -eq 0 ] || usage
        prepare_runtime_dirs
        route_system_dns
        ;;
    deactivate)
        [ "$#" -eq 0 ] || usage
        systemctl stop "$SERVICE_NAME"
        revert_system_dns
        ;;
    startup)
        [ "$#" -eq 1 ] || usage
        validate_bool "$1"

        if [ "$1" = true ]; then
            systemctl enable "$SERVICE_NAME"
        else
            systemctl disable "$SERVICE_NAME"
        fi
        ;;
    *)
        usage
        ;;
esac
